<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HappyPlaceDetailActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/placeDetailToolbar"
        android:background="@color/colorPrimary"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:theme="@style/CustomToolbarStyle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageView
        android:id="@+id/placeImageIv"
        android:layout_width="match_parent"
        android:layout_height="@dimen/detail_image_size"
        android:contentDescription="@string/detail_image_description"
        android:scaleType="centerCrop"
        android:src="@drawable/add_screen_image_placeholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/placeDetailToolbar" />

    <TextView
        android:id="@+id/descriptionTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/detail_description_margin"
        android:textSize="@dimen/detail_description_text_size"
        android:textStyle="bold"
        tools:text="Description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/placeImageIv"/>

    <TextView
        android:id="@+id/locationTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/detail_location_marginStartEnd"
        android:layout_marginEnd="@dimen/detail_location_marginStartEnd"
        android:layout_marginTop="@dimen/detail_location_marginTop"
        android:textColor="@color/colorAccent"
        android:textSize="@dimen/detail_location_text_size"
        android:textStyle="bold"
        tools:text="Location"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/descriptionTv"/>

    <Button
        android:id="@+id/viewOnMapBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_button_rounded"
        android:gravity="center"
        android:layout_marginStart="@dimen/detail_btn_marginStartEnd"
        android:layout_marginEnd="@dimen/detail_btn_marginStartEnd"
        android:layout_marginTop="@dimen/detail_btn_marginTop"
        android:paddingTop="@dimen/detail_btn_paddingTopBottom"
        android:paddingBottom="@dimen/detail_btn_paddingTopBottom"
        android:text="@string/view_on_map_text_btn"
        android:textColor="@color/white"
        android:textSize="@dimen/detail_btn_textSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:flow_horizontalBias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/locationTv"/>

</androidx.constraintlayout.widget.ConstraintLayout>